{
  "name": "orbit-personal-assistant",
  "version": "0.66.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch services/backend/src/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "test": "tsx --test tests/*.test.ts services/code-browser/*.test.mjs",
    "check": "npm run lint && npm run format:check && npm run architecture:check && npm run releases:check && npm run docs:check && tsc --noEmit",
    "test:sdk": "tsx scripts/check-sdk.ts",
    "format": "prettier --write .",
    "docs:generate": "node scripts/generate-help.mjs",
    "docs:check": "node scripts/generate-help.mjs --check",
    "releases:check": "node scripts/check-releases.mjs",
    "architecture:check": "node --test scripts/check-architecture.test.mjs && node scripts/check-architecture.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.22",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "better-sqlite3": "^11.10.0",
    "decode-named-character-reference": "1.3.0",
    "diff": "^8.0.4",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jszip": "^3.10.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "re2js": "2.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "refractor": "^5.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.3.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "koffi": true
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
