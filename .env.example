# These variables apply to local development. Compose supplies its own defaults.
PORT=43871
BIND_HOST=127.0.0.1
DATA_DIR=./data
APP_ORIGINS=http://localhost:43871,http://127.0.0.1:43871,http://localhost:5173,http://127.0.0.1:5173
VOICE_URL=http://127.0.0.1:8000
# For a corporate CA: mount a PEM file and set NODE_EXTRA_CA_CERTS to its path.
# Never disable TLS validation.

# Local development only: run services/code-browser/service.mjs separately.
# Compose configures these automatically and uses a dedicated control volume.
# CODE_BROWSER_URL=http://127.0.0.1:8010
# CODE_BROWSER_KEY_FILE=/absolute/path/to/repo-control/key
# Code-browser settings (also passed into Docker Compose):
# Total cache quota: 20 GiB. Downloaded data is retained when exceeded.
# CODE_BROWSER_MAX_CACHE_BYTES=21474836480
# History depth: 1 for code browsing; raise for more accurate behind counts.
# 0 = full history of all branches and tags; 1–1000 = selected-branch depth
# CODE_BROWSER_FETCH_DEPTH=1
